# Sous — Edge Function secrets (SPEC §9.7 / §10.3)
# In the cloud, set these with:  supabase secrets set KEY=value
# For local `supabase functions serve`, copy this to `.env` and fill it in.
# NEVER commit a filled-in copy. See SETUP.md.

# From BotFather (/newbot).
TELEGRAM_BOT_TOKEN=12345:AA...

# From console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...

# Random strings you generate (see SETUP.md step 6). The webhook secret is also
# passed to Telegram setWebhook; the kickoff secret gates the hourly cron.
TG_WEBHOOK_SECRET=
KICKOFF_SECRET=

# Comma-separated Telegram ids allowed to use the bot: the group chat id and/or
# each person's user id. Find yours via getUpdates (SETUP.md step 8).
TELEGRAM_ALLOWED_CHAT_IDS=

# Auto-injected in the cloud; only set locally if your function calls the DB.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — override the Claude models (defaults shown). Handy for cost control
# or when a pinned snapshot is retired. Leave unset to use the defaults.
# SOUS_INTENT_MODEL=claude-haiku-4-5-20251001   # cheap intent routing
# SOUS_CHAT_MODEL=claude-sonnet-4-6             # onboarding + chat
# SOUS_PLANNER_MODEL=claude-sonnet-4-6          # planning / swaps / customize
